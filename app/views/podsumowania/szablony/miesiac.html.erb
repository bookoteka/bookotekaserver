<head>
  <meta charset="UTF-8">
  <style>
    <%= Rails.application.assets&.find_asset('application.css')&.source || File.read(Rails.root.join('app/assets/builds/application.css')) rescue "" %>
    @page {
      size: A4;
      margin: 12mm;
    }
    html, body {
      background-color: #ffffff !important;
      margin: 0 !important;
      padding: 0 !important;
      -webkit-print-color-adjust: exact;
    }
  </style>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-white text-slate-800 font-sans">
  <div class="w-full bg-white">
    <!-- Nagłówek -->
    <header class="border-b-2 border-slate-900 pb-3 mb-5 flex justify-between items-end">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900"><%= @nazwa_miesiaca %> <%= @rok %> – podsumowanie</h1>
        <p class="text-xs text-slate-500 mt-0.5">Raport aktywności czytelniczej</p>
      </div>
      <div class="text-right text-xs text-slate-400">
        System Czytelniczy
      </div>
    </header>

    <!-- Kafelki ze statystykami -->
    <section class="grid grid-cols-2 gap-4 mb-5">
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 text-center">
        <span class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Przeczytane książki</span>
        <span class="text-3xl font-extrabold text-primary-600"><%= @lacznie_ksiazek %></span>
      </div>
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 text-center">
        <span class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Przeczytane strony</span>
        <span class="text-3xl font-extrabold text-primary-600"><%= @lacznie_stron %></span>
      </div>
    </section>

    <!-- Sekcja z sekcjami wykresów/rozkładów -->
    <section class="grid grid-cols-2 gap-4 mb-5">
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
        <h3 class="text-xs font-semibold text-slate-600 uppercase tracking-wider mb-2 pb-1 border-b border-slate-200">Formaty</h3>
        <div class="space-y-1.5">
          <% @rozklad_formatow.each do |format, ilosc| %>
            <div class="flex justify-between items-center text-xs">
              <span class="text-slate-700"><%= format %></span>
              <span class="font-bold text-slate-900"><%= ilosc %></span>
            </div>
          <% end %>
        </div>
      </div>

      <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
        <h3 class="text-xs font-semibold text-slate-600 uppercase tracking-wider mb-2 pb-1 border-b border-slate-200">Oceny</h3>
        <div class="space-y-1.5">
          <% @rozklad_ocen.each do |ocena, ilosc| %>
            <div class="flex justify-between items-center text-xs">
              <span class="text-slate-700"><%= ocena %></span>
              <span class="font-bold text-slate-900"><%= ilosc %></span>
            </div>
          <% end %>
        </div>
      </div>
    </section>

    <!-- Tabelka z gatunkami -->
    <section class="mb-5">
      <h2 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-2">Popularność gatunków</h2>
      <div class="border border-slate-200 rounded-xl overflow-hidden">
        <table class="w-full text-left text-xs border-collapse">
          <thead class="bg-slate-100 border-b border-slate-200 text-slate-700 uppercase">
            <tr>
              <th class="py-2 px-3 font-semibold">Gatunek</th>
              <th class="py-2 px-3 font-semibold text-right">Liczba książek</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @statystyki_gatunkow.each do |gatunek, ilosc| %>
              <tr class="hover:bg-slate-50">
                <td class="py-1.5 px-3 font-medium text-slate-800"><%= gatunek %></td>
                <td class="py-1.5 px-3 text-right font-bold text-primary-600"><%= ilosc %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Tabelka z książkami -->
    <section class="mb-5">
      <h2 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-2">Lista przeczytanych książek</h2>
      <div class="border border-slate-200 rounded-xl overflow-hidden">
        <table class="w-full text-left text-xs border-collapse">
          <thead class="bg-slate-100 border-b border-slate-200 text-slate-700 uppercase">
            <tr>
              <th class="py-2 px-2.5 font-semibold text-center w-8">Lp.</th>
              <th class="py-2 px-2.5 font-semibold">Tytuł</th>
              <th class="py-2 px-2.5 font-semibold">Autor</th>
              <th class="py-2 px-2.5 font-semibold">Seria</th>
              <th class="py-2 px-2.5 font-semibold">Format</th>
              <th class="py-2 px-2.5 font-semibold text-center">Ocena</th>
              <th class="py-2 px-2.5 font-semibold">Gatunki</th>
              <th class="py-2 px-2.5 font-semibold text-right">Strony</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @ksiazki.each_with_index do |ksiazka, indeks| %>
              <tr class="hover:bg-slate-50">
                <td class="py-1.5 px-2.5 text-center text-slate-400 font-medium"><%= indeks + 1 %></td>
                <td class="py-1.5 px-2.5 font-semibold text-slate-900"><%= ksiazka[:tytul] %></td>
                <td class="py-1.5 px-2.5 text-slate-700"><%= ksiazka[:autor] %></td>
                <td class="py-1.5 px-2.5 text-slate-500"><%= ksiazka[:seria] || "-" %></td>
                <td class="py-1.5 px-2.5 text-slate-600"><%= ksiazka[:format] %></td>
                <td class="py-1.5 px-2.5 text-center font-bold text-slate-800">
                  <%= ksiazka[:ocena].to_s[0..2] %>
                </td>
                <td class="py-1.5 px-2.5 text-slate-600">
                  <%= ksiazka[:gatunki].join(", ") %>
                </td>
                <td class="py-1.5 px-2.5 text-right font-medium text-slate-900"><%= ksiazka[:strony] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Tabelka z czasopismami -->
    <section>
      <h2 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-2">Przeczytane czasopisma</h2>
      <div class="border border-slate-200 rounded-xl overflow-hidden">
        <table class="w-full text-left text-xs border-collapse">
          <thead class="bg-slate-100 border-b border-slate-200 text-slate-700 uppercase">
            <tr>
              <th class="py-2 px-2.5 font-semibold text-center w-8">Lp.</th>
              <th class="py-2 px-2.5 font-semibold">Nazwa</th>
              <th class="py-2 px-2.5 font-semibold">Numer</th>
              <th class="py-2 px-2.5 font-semibold text-right">Strony</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% if @czasopisma.present? %>
              <% @czasopisma.each_with_index do |czasopismo, indeks| %>
                <tr class="hover:bg-slate-50">
                  <td class="py-1.5 px-2.5 text-center text-slate-400 font-medium"><%= indeks + 1 %></td>
                  <td class="py-1.5 px-2.5 font-semibold text-slate-900"><%= czasopismo[:nazwa] %></td>
                  <td class="py-1.5 px-2.5 text-slate-700"><%= czasopismo[:numer] %></td>
                  <td class="py-1.5 px-2.5 text-right font-medium text-slate-900"><%= czasopismo[:strony] %></td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="4" class="py-3 text-center text-slate-400">Brak przeczytanych czasopism w tym miesiącu.</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</body>