<div class="max-w-5xl mx-auto p-6">
  <!-- Nagłówek i przyciski akcji -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
    <div>
      <h1 class="text-3xl font-bold text-slate-900">Podsumowania i Raporty</h1>
      <p class="text-slate-500 text-sm mt-1">Wygenerowane raporty czytelnicze zapisane w systemie.</p>
    </div>

    <div class="flex items-center gap-3">
      <%= link_to root_path, class: "inline-flex items-center gap-2 px-4 py-2.5 text-sm font-medium text-slate-700 bg-white border border-slate-200 rounded-lg shadow-sm hover:bg-slate-50 hover:text-slate-900 transition-colors duration-150" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M15.41 16.59L10.83 12l4.58-4.59L14 6l-6 6 6 6 1.41-1.41z"/>
        </svg>
        Strona główna
      <% end %>

      <button onclick="otworzModal()" class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium px-4 py-2.5 rounded-lg shadow-sm transition-colors text-sm cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        Generuj raport
      </button>
    </div>
  </div>

  <!-- Lista plików PDF -->
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-200 bg-slate-50/50 flex items-center justify-between">
      <h2 class="font-semibold text-slate-800">Dostępne pliki PDF</h2>
      <span class="text-xs font-medium px-2.5 py-1 bg-slate-200 text-slate-700 rounded-full">
        Pliki: <%= @pliki.count %>
      </span>
    </div>

    <% if @pliki.any? %>
      <div class="divide-y divide-slate-100">
        <% @pliki.each do |nazwa_pliku| %>
          <% id_pliku = File.basename(nazwa_pliku, ".pdf") %>
          <div class="px-6 py-4 flex items-center justify-between hover:bg-slate-50/80 transition-colors">
            <div class="flex items-center gap-3">
              <div class="p-2 bg-rose-50 text-rose-600 rounded-lg">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <span class="font-medium text-slate-900 block"><%= nazwa_pliku %></span>
                <span class="text-xs text-slate-500">Dokument PDF</span>
              </div>
            </div>

            <div class="flex items-center gap-3">
              <%= link_to "/podsumowania/#{id_pliku}", class: "text-indigo-600 hover:text-indigo-800 font-medium text-sm transition-colors" do %>
                Otwórz podgląd &rarr;
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="p-12 text-center text-slate-500">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto text-slate-300 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        Brak wygenerowanych raportów w katalogu <code class="text-xs bg-slate-100 px-1.5 py-0.5 rounded">storage/raporty/</code>.
      </div>
    <% end %>
  </div>
</div>

<!-- Modal wyboru daty -->
<dialog id="modal-podsumowanie" class="rounded-2xl p-0 backdrop:bg-slate-900/50 shadow-2xl max-w-md w-full border border-slate-200">
  <div class="p-6">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-lg font-bold text-slate-900">Generuj podsumowanie</h3>
      <button type="button" onclick="zamknijModal()" class="text-slate-400 hover:text-slate-600 p-1 rounded-lg">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <%= form_with url: "/podsumowania", method: :post, local: true, class: "space-y-4" do |f| %>
      <div>
        <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-2">Typ raportu</label>
        <select name="typ" id="wybor-typu" onchange="przelaczTyp()" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500">
          <option value="miesieczne">Miesięczne</option>
          <option value="roczne">Roczne</option>
        </select>
      </div>

      <div id="kontener-miesiac">
        <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-2">Miesiąc</label>
        <select name="miesiac" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500">
          <% [["Styczeń", 1], ["Luty", 2], ["Marzec", 3], ["Kwiecień", 4], ["Maj", 5], ["Czerwiec", 6], ["Lipiec", 7], ["Sierpień", 8], ["Wrzesień", 9], ["Październik", 10], ["Listopad", 11], ["Grudzień", 12]].each do |nazwa, nr| %>
            <option value="<%= nr %>" <%= "selected" if nr == Date.today.month %>><%= nazwa %></option>
          <% end %>
        </select>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-2">Rok</label>
        <select name="rok" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500">
          <% (2024..Date.today.year).reverse_each do |r| %>
            <option value="<%= r %>"><%= r %></option>
          <% end %>
        </select>
      </div>

      <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
        <button type="button" onclick="zamknijModal()" class="px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100 rounded-lg transition-colors">
          Anuluj
        </button>
        <button type="submit" class="px-4 py-2 text-sm font-medium bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg shadow-sm transition-colors cursor-pointer">
          Generuj PDF
        </button>
      </div>
    <% end %>
  </div>
</dialog>

<script>
  function otworzModal() {
    przelaczTyp();
    document.getElementById('modal-podsumowanie').showModal();
  }

  function zamknijModal() {
    document.getElementById('modal-podsumowanie').close();
  }

  function przelaczTyp() {
    const typ = document.getElementById('wybor-typu').value;
    const kontenerMiesiac = document.getElementById('kontener-miesiac');
    kontenerMiesiac.style.display = (typ === 'roczne') ? 'none' : 'block';
  }
</script>