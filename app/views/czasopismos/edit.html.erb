<div class="max-w-2xl mx-auto bg-white p-6 sm:p-8 rounded-xl border border-slate-200/80 shadow-sm">
  <h1 class="text-4xl font-bold mb-6 text-indigo-800">Edytuj czasopismo</h1>

  <% if @czasopismo.errors.any? %>
    <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg text-red-700">
      <h2 class="font-semibold mb-2">Formularz zawiera <%= @czasopismo.errors.count %> <%= @czasopismo.errors.count == 1 ? "błąd" : "błędy" %>:</h2>
      <ul class="list-disc list-inside text-sm space-y-1">
        <% @czasopismo.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with(model: @czasopismo, local: true, class: "space-y-5") do |f| %>
    <div>
      <%= f.label :tytul, "Tytuł czasopisma:" %><br>
      <%= f.text_field :tytul, required: true, placeholder: "np. CD-Action, Programista", class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <div>
      <%= f.label :numer_wydania, "Numer wydania:" %><br>
      <%= f.text_field :numer_wydania, required: true, placeholder: "np. 03/2026 lub 12", class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <div>
      <%= f.label :strony, "Liczba stron:" %><br>
      <%= f.number_field :strony, required: true, placeholder: "np. 100", class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none" %>
    </div>

    <hr class="border-slate-200 my-4">

    <div class="pt-4 flex flex-col sm:flex-row items-center gap-3">
      <%= f.submit "Zapisz zmiany", class: "w-full sm:w-auto px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-lg shadow-sm transition-colors cursor-pointer text-center" %>
      
      <%= link_to "Anuluj", czasopismo_path(@czasopismo), class: "w-full sm:w-auto px-6 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium rounded-lg transition-colors text-center" %>
    </div>
  <% end %>
</div>