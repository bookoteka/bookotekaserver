<div style="padding: 1rem;">
  <h1 class="text-5xl font-bold text-slate-800 mb-6">Rejestr książek</h1>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
    <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm">
      <span class="text-sm font-medium text-gray-500 uppercase tracking-wider block">Przeczytane książki</span>
      <span class="text-3xl font-extrabold text-indigo-600"><%= @liczba_ksiazek %></span>
    </div>

    <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm">
      <span class="text-sm font-medium text-gray-500 uppercase tracking-wider block">Suma przeczytanych stron</span>
      <span class="text-3xl font-extrabold text-indigo-600"><%= @suma_stron || 0 %></span>
    </div>
  </div>

  <div>
    <%= link_to "Dodaj nową książkę", new_ksiazka_path, class: "inline-block bg-indigo-600 hover:bg-indigo-700 text-white font-medium px-4 py-2.5 rounded-lg shadow-sm transition" %>
  </div>

  <br><br>

  <div class="bg-white shadow-sm rounded-xl border border-gray-200 overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200 text-left">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Tytuł</th>
          <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Autor</th>
          <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Seria</th>
          <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Format</th>
          <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Ocena</th>
          <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Gatunki</th>
          <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Strony</th>
          <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Akcje</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @ksiazkas.each do |ksiazka| %>
          <tr class="hover:bg-gray-50 transition">
            <td class="px-6 py-4 font-semibold text-gray-900"><%= ksiazka.tytul %></td>
            <td class="px-6 py-4 text-gray-600 capitalize"><%= ksiazka.autor %></td>
            <td class="px-6 py-4 text-gray-600"><%= ksiazka.nazwa_serii %></td>
            <td class="px-6 py-4 text-gray-600"><%= ksiazka.format_ksiazki %></td>
            <td class="px-6 py-4 text-gray-600"><%= ksiazka.ocena %></td>
            <td class="px-6 py-4 text-gray-600"><%= ksiazka.gatuneks.map(&:nazwa).join(", ") %></td>
            <td class="px-6 py-4 text-gray-600"><%= ksiazka.strony %></td>
            <td class="px-6 py-4">
              <%= link_to "Pokaż", ksiazka_path(ksiazka), class: "text-indigo-600 hover:text-indigo-900 font-medium" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>