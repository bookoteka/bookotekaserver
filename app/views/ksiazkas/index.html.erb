<div style="padding: 1rem;">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-5xl font-bold text-indigo-900">bookoteka</h1>
    <%= link_to ustawienia_path, class: "p-2 text-primary-900 hover:text-primary-600 hover:bg-primary-50 rounded-full transition-colors" do %>
      <svg 
        xmlns="http://www.w3.org/2000/svg" 
        fill="none" 
        viewBox="0 0 24 24" 
        stroke-width="1.75" 
        stroke="currentColor" 
        class="w-8 h-8"
      >
        <path 
          stroke-linecap="round" 
          stroke-linejoin="round" 
          d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 010-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.28z" 
        />
        <path 
          stroke-linecap="round" 
          stroke-linejoin="round" 
          d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" 
        />
      </svg>
    <% end %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
    <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm">
      <span class="text-sm font-medium text-gray-500 uppercase tracking-wider block">Przeczytane książki</span>
      <span class="text-3xl font-extrabold text-indigo-600"><%= @liczba_ksiazek %></span>
    </div>

    <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm">
      <span class="text-sm font-medium text-gray-500 uppercase tracking-wider block">Suma przeczytanych stron</span>
      <span class="text-3xl font-extrabold text-indigo-600"><%= @suma_stron || 0 %></span>
    </div>
  </div>

  <!-- Wykresy -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-6">
    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex flex-col justify-between">
      <h3 class="text-base font-semibold text-slate-800 mb-3 text-center">
        Podział według formatów
      </h3>

      <%= pie_chart Ksiazka.group(:format_ksiazki).count, 
                    donut: true, 
                    height: "220px",
                    colors: ["#6366f1", "#8b5cf6", "#e11d48", "#0ea5e9"],
                    legend: "bottom",
                    empty: "Brak zdefiniowanych formatów książek" %>
    </div>

    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex flex-col justify-between">
      <h3 class="text-base font-semibold text-slate-800 mb-3 text-center">
        Rozkład ocen książek
      </h3>

      <%= column_chart Ksiazka.group(:ocena).count,
                      height: "220px",
                      colors: ["#8b5cf6"],
                      xtitle: "Ocena",
                      ytitle: "Liczba książek",
                      empty: "Brak ocenionych książek" %>
    </div>
  </div>

  <!-- Przyciski akcji -->
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div class="flex flex-wrap items-center gap-3">
      <%= link_to "Dodaj nową książkę", new_ksiazka_path, class: "inline-block bg-indigo-600 hover:bg-indigo-700 text-white font-medium px-4 py-2.5 rounded-lg shadow-sm transition-colors text-sm" %>
    </div>

    <%= link_to "/podsumowania", class: "inline-flex items-center gap-2 bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 font-medium px-4 py-2.5 rounded-lg shadow-sm transition-colors text-sm" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
      </svg>
      Podsumowania i Raporty
    <% end %>
  </div>

  <!-- Książki -->
  <div class="mt-10 bg-white rounded-xl border border-slate-200/80 shadow-sm overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between bg-slate-50/50">
      <h2 class="text-xl font-bold text-slate-800">Przeczytane książki</h2>
      <span class="text-xs font-semibold px-2.5 py-1 bg-indigo-100 text-indigo-800 rounded-full">
        Łącznie: <%= @ksiazkas.count %>
      </span>
    </div>

    <% if @ksiazkas.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="border-b border-slate-200 text-slate-500 bg-slate-50/30">
              <th class="py-3 px-6 font-semibold">Tytuł</th>
              <th class="py-3 px-6 font-semibold">Autor</th>
              <th class="py-3 px-6 font-semibold">Seria</th>
              <th class="py-3 px-6 font-semibold">Format</th>
              <th class="py-3 px-6 font-semibold">Ocena</th>
              <th class="py-3 px-6 font-semibold">Gatunki</th>
              <th class="py-3 px-6 font-semibold">Strony</th>
              <th class="py-3 px-6 font-semibold text-right">Akcje</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @ksiazkas.each do |ksiazka| %>
              <tr class="hover:bg-slate-50/80 transition-colors">
                <td class="py-3.5 px-6 font-medium text-slate-900">
                  <%= link_to ksiazka.tytul, ksiazka_path(ksiazka), class: "hover:text-indigo-600 transition-colors" %>
                </td>
                <td class="py-3.5 px-6 text-slate-600 capitalize"><%= ksiazka.autor %></td>
                <td class="py-3.5 px-6 text-slate-600"><%= ksiazka.nazwa_serii %></td>
                <td class="py-3.5 px-6 text-slate-600"><%= ksiazka.format_ksiazki %></td>
                <td class="py-3.5 px-6 text-slate-600"><%= ksiazka.ocena %></td>
                <td class="py-3.5 px-6 text-slate-600"><%= ksiazka.gatuneks.map(&:nazwa).join(", ") %></td>
                <td class="py-3.5 px-6 text-slate-600"><%= ksiazka.strony %></td>
                <td class="py-3.5 px-6 text-right space-x-2">
                  <%= link_to "Pokaż", ksiazka_path(ksiazka), class: "text-indigo-600 hover:text-indigo-900 font-medium text-xs" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="p-8 text-center text-slate-500">
        Brak przeczytanych książek na liście.
      </div>
    <% end %>
  </div>
</div>