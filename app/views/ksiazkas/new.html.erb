<div class="max-w-2xl mx-auto bg-white p-6 sm:p-8 rounded-xl border border-slate-200/80 shadow-sm">
  <h1 class="text-2xl font-bold text-slate-800 mb-6">Dodaj nową książkę</h1>

  <%= form_with(model: @ksiazka, local: true, class: "space-y-5") do |f| %>
    <div>
      <%= f.label :tytul, "Tytuł:" %><br>
      <%= f.text_field :tytul, required: true, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 disabled:bg-slate-100 disabled:text-slate-400"  %>
    </div>

    <div>
      <%= f.label :autor, "Autor:" %><br>
      <%= f.text_field :autor, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 disabled:bg-slate-100 disabled:text-slate-400" %>
    </div>

    <div>
      <%= f.check_box :jednotomowka, id: "jednotomowka_checkbox" %>
      <%= f.label :jednotomowka, "Jednotomówka" %>
    </div>

    <div>
      <%= f.label :nazwa_serii, "Nazwa serii:" %><br>
      <%= f.text_field :nazwa_serii, id: "nazwa_serii_input", class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 disabled:bg-slate-100 disabled:text-slate-400" %>
    </div>

    <div>
      <%= f.label :strony, "Liczba stron:" %><br>
      <%= f.number_field :strony, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 disabled:bg-slate-100 disabled:text-slate-400" %>
    </div>

    <div>
      <%= f.label :ocena, "Ocena:" %><br>
      <div class="relative">
        <%= f.select :ocena, [
          ["1/6 Grand Prix gówna", "1/6 Grand Prix gówna"],
          ["2/6 Szkoda drzew", "2/6 Szkoda drzew"],
          ["3/6 Ok", "3/6 Ok"],
          ["4/6 Klasa", "4/6 Klasa"],
          ["5/6 Złoto", "5/6 Złoto"],
          ["6/6 Arcydzieło", "6/6 Arcydzieło"]
        ], { include_blank: "Wybierz ocenę" }, 
        { class: "w-full appearance-none rounded-lg border border-slate-300 px-3 py-2 pr-8 text-slate-900 bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 cursor-pointer text-sm" } %>

        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2.5 text-slate-500">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </div>
      </div>
    </div>

    <div>
      <%= f.label :format_ksiazki, "Format książki:" %><br>
      <div class="relative">
        <%= f.select :format_ksiazki, 
            ["Papierowa", "E-book", "Audiobook"], 
            { include_blank: "Wybierz format" }, 
            { class: "w-full appearance-none rounded-lg border border-slate-300 px-3 py-2 pr-8 text-slate-900 bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 cursor-pointer text-sm" } %>

        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2.5 text-slate-500">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </div>
      </div>
    </div>

    <div>
      <%= f.check_box :dnf %>
      <%= f.label :dnf, "DNF (Nie ukończono / Porzucono)" %>
    </div>
    <hr>

    <h3>Gatunki (zaznacz właściwe):</h3>
    <div style="display: flex; flex-wrap: wrap; gap: 10px;">
      <% @gatunki.each do |gatunek| %>
        <label style="border: 1px solid #ccc; padding: 10px 15px; border-radius: 8px; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; background-color: #f9f9f9;">
          <%= check_box_tag "ksiazka[gatunek_ids][]", gatunek.id, @ksiazka.gatunek_ids.include?(gatunek.id) %>
          <span><%= gatunek.nazwa %></span>
        </label>
      <% end %>
    </div>
    <hr>

    <div>
      <%= f.submit "Zapisz książkę" %>
    </div>
  <% end %>

  <br>
  <%= link_to "Powrót do listy książek", ksiazkas_path %>
</div>

<script>
  document.addEventListener("turbo:load", function() {
    const checkbox = document.getElementById("jednotomowka_checkbox");
    const input = document.getElementById("nazwa_serii_input");
    if (!checkbox || !input) return;
    function toggleNazwaSerii() {
      if (checkbox.checked) {
        input.value = "";
        input.disabled = true;
        input.style.backgroundColor = "#e9e9e9";
        input.style.cursor = "not-allowed"
      } else {
        input.disabled = false;
        input.style.backgroundColor = "";
        input.style.cursor = "text"
      }
    }
    checkbox.addEventListener("change", toggleNazwaSerii);
    toggleNazwaSerii();
  });
</script>