<h1>Dodaj nową książkę</h1>

<%= form_with(model: @ksiazka, local: true) do |f| %>
  <div>
    <%= f.label :tytul, "Tytuł:" %><br>
    <%= f.text_field :tytul, required: true %>
  </div>

  <br>

  <div>
    <%= f.label :autor, "Autor:" %><br>
    <%= f.text_field :autor %>
  </div>

  <br>

  <div>
    <%= f.check_box :jednotomowka, id: "jednotomowka_checkbox" %>
    <%= f.label :jednotomowka, "Jednotomówka" %>
  </div>

  <br>

  <div>
    <%= f.label :nazwa_serii, "Nazwa serii:" %><br>
    <%= f.text_field :nazwa_serii, id: "nazwa_serii_input" %>
  </div>

  <br>

  <div>
    <%= f.label :strony, "Liczba stron:" %><br>
    <%= f.number_field :strony %>
  </div>

  <br>

  <div>
    <%= f.label :ocena, "Ocena:" %><br>
    <%= f.select :ocena, [
      ["1/6 Grand Prix gówna", "1/6 Grand Prix gówna"],
      ["2/6 Szkoda drzew", "2/6 Szkoda drzew"],
      ["3/6 Ok", "3/6 Ok"],
      ["4/6 Klasa", "4/6 Klasa"],
      ["5/6 Złoto", "5/6 Złoto"],
      ["6/6 Arcydzieło", "6/6 Arcydzieło"]
    ], include_blank: "Wybierz ocenę" %>
  </div>

  <br>

  <div>
    <%= f.label :format_ksiazki, "Format książki:" %><br>
    <%= f.select :format_ksiazki, ["Papierowa", "E-book", "Audiobook"], include_blank: "Wybierz format" %>
  </div>

  <br>

  <div>
    <%= f.check_box :dnf %>
    <%= f.label :dnf, "DNF (Nie ukończono / Porzucono)" %>
  </div>

  <br>
  <hr>

  <h3>Gatunki (zaznacz właściwe):</h3>
  <div style="display: flex; flex-wrap: wrap; gap: 10px;">
    <% @gatunki.each do |gatunek| %>
      <label style="border: 1px solid #ccc; padding: 10px 15px; border-radius: 8px; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; background-color: #f9f9f9;">
        <%= check_box_tag "ksiazka[gatunek_ids][]", gatunek.id, @ksiazka.gatunek_ids.include?(gatunek.id) %>
        <span><%= gatunek.nazwa %></span>
      </label>
    <% end %>
  </div>

  <br><hr><br>

  <div>
    <%= f.submit "Zapisz książkę" %>
  </div>
<% end %>

<br>
<%= link_to "Powrót do listy książek", ksiazkas_path %>

<script>
  document.addEventListener("turbo:load", function() {
    const checkbox = document.getElementById("jednotomowka_checkbox");
    const input = document.getElementById("nazwa_serii_input");

    if (!checkbox || !input) return;

    function toggleNazwaSerii() {
      if (checkbox.checked) {
        input.value = "";
        input.disabled = true;
        input.style.backgroundColor = "#e9e9e9";
      } else {
        input.disabled = false;
        input.style.backgroundColor = "";
      }
    }

    checkbox.addEventListener("change", toggleNazwaSerii);
    toggleNazwaSerii();
  });
</script>