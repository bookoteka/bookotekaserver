<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; background-color: #f8fafc; border-radius: 12px; border: 1px solid #e2e8f0;">
  
  <div style="border-bottom: 2px solid #6366f1; padding-bottom: 12px; margin-bottom: 20px;">
    <h1 style="color: #1e1b4b; font-size: 22px; margin: 0; font-weight: 700;">System Czytelniczy</h1>
  </div>

  <div style="background-color: #ffffff; padding: 20px; border-radius: 8px; border: 1px solid #cbd5e1;">
    <h2 style="color: #334155; font-size: 18px; margin-top: 0;">Cześć!</h2>
    
    <p style="color: #475569; font-size: 15px; line-height: 1.6;">
      W załączniku tej wiadomości znajdziesz wygenerowane <strong>podsumowanie <%= @typ_raportu %></strong>.
    </p>

    <div style="background-color: #f1f5f9; padding: 12px 16px; border-radius: 6px; margin: 16px 0; border-left: 4px solid #6366f1;">
      <span style="color: #64748b; font-size: 13px; display: block; font-weight: 600; text-transform: uppercase;">Załączony plik</span>
      <strong style="color: #0f172a; font-size: 15px;"><%= @nazwa_pliku %></strong>
    </div>
  </div>

  <div style="text-align: center; margin-top: 20px; color: #94a3b8; font-size: 12px;">
    Wiadomość wygenerowana automatycznie przez Twój System Czytelniczy.
  </div>

</div>