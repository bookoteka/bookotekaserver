<div class="space-y-6">
  <div>
    <h1 class="text-4xl font-bold text-primary-900">Eksport danych</h1>
    <p class="text-sm text-slate-500 mt-1">
      Zapisz kopię zapasową bazy danych aplikacji w wybranym miejscu na dysku.
    </p>
  </div>

  <div class="p-6 bg-slate-50 rounded-2xl border border-slate-100 flex flex-col items-start gap-4">
    <div class="flex items-center gap-3">
      <div class="p-3 bg-primary-100 text-primary-700 rounded-xl">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
      </div>
      <div>
        <h3 class="font-semibold text-slate-800">Kopia bezpieczeństwa (SQLite)</h3>
        <p class="text-xs text-slate-500">Zawiera wszystkie książki, ocenione pozycje oraz gatunki.</p>
      </div>
    </div>

    <%= link_to "Eksportuj bazę danych", 
                eksport_ustawienia_path, 
                class: "px-5 py-2.5 bg-primary-600 hover:bg-primary-700 text-white font-medium rounded-xl transition-colors shadow-sm inline-flex items-center gap-2", 
                download: "#{Rails.env}.sqlite3",
                data: { turbo: false } %>
  </div>
</div>